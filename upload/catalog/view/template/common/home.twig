<script type="text/javascript">
// Flash sale countdown timer simulation
function startTimer(duration, displayH, displayM, displayS) {
    var timer = duration, hours, minutes, seconds;
    setInterval(function () {
        hours = parseInt(timer / 3600, 10);
        minutes = parseInt((timer % 3600) / 60, 10);
        seconds = parseInt(timer % 60, 10);

        displayH.textContent = hours < 10 ? "0" + hours : hours;
        displayM.textContent = minutes < 10 ? "0" + minutes : minutes;
        displayS.textContent = seconds < 10 ? "0" + seconds : seconds;

        if (--timer < 0) {
            timer = duration;
        }
    }, 1000);
}

window.addEventListener('DOMContentLoaded', function () {
    var h = document.getElementById('flash-hours');
    var m = document.getElementById('flash-mins');
    var s = document.getElementById('flash-secs');
    if (h && m && s) {
        startTimer(9850, h, m, s);
    }
});

// Quick Add To Cart function
function addToCart(productId) {
    $.ajax({
        url: 'index.php?route=checkout/cart.add',
        type: 'post',
        data: { product_id: productId, quantity: 1 },
        dataType: 'json',
        success: function(json) {
            alert('Đã thêm sản phẩm công nghệ vào giỏ hàng thành công!');
            var countEl = document.querySelector('.cart-count');
            if (countEl) {
                countEl.textContent = (parseInt(countEl.textContent) || 0) + 1;
            }
        },
        error: function() {
            alert('Đã thêm vào giỏ hàng!');
        }
    });
}
</script>

