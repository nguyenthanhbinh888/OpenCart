{{ header }}
<div id="product-category" class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
      <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>

  <div class="row">
    {{ column_left }}

    <div id="content" class="col">
      {{ content_top }}

      <!-- Category Title & Description -->
      <div class="category-header-box mb-3">
        <h1 class="category-main-title">{{ heading_title }}</h1>
        {% if description %}
          <p class="category-desc-text">{{ description }}</p>
        {% endif %}
      </div>

      {% if categories %}
        <div class="sub-categories-bar mb-3">
          <span style="font-weight: 700; font-size: 13px; color: #475569; margin-right: 8px;">Chọn danh mục con:</span>
          {% for category in categories %}
            <a href="{{ category.href }}" class="sub-cat-pill">{{ category.name }}</a>
          {% endfor %}
        </div>
      {% endif %}

      {% if products %}
        <!-- Filter & Sort Bar -->
        <div class="category-toolbar mb-4">
          <div class="toolbar-left">
            <span class="toolbar-label"><i class="fa-solid fa-arrow-down-wide-short"></i> Sắp xếp theo:</span>
            <select id="input-sort" class="form-select form-select-sm toolbar-select" onchange="location = this.value;">
              {% for sorts in sorts %}
                <option value="{{ sorts.href }}"{% if sorts.value == '%s-%s'|format(sort, order) %} selected{% endif %}>{{ sorts.text }}</option>
              {% endfor %}
            </select>
          </div>

          <div class="toolbar-right">
            <span class="toolbar-label">Hiển thị:</span>
            <select id="input-limit" class="form-select form-select-sm toolbar-select" onchange="location = this.value;">
              {% for limits in limits %}
                <option value="{{ limits.href }}"{% if limits.value == limit %} selected{% endif %}>{{ limits.text }}</option>
              {% endfor %}
            </select>
          </div>
        </div>

        <!-- Products Grid: 3 columns on desktop for perfect readability -->
        <div id="product-list" class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-3 g-3">
          {% for product in products %}
            <div class="col">{{ product }}</div>
          {% endfor %}
        </div>

        <!-- Pagination -->
        <div class="row mt-4 align-items-center">
          <div class="col-sm-6 text-start">{{ pagination }}</div>
          <div class="col-sm-6 text-end text-muted" style="font-size: 13px;">{{ results }}</div>
        </div>
      {% endif %}

      {% if not categories and not products %}
        <div class="empty-products-box text-center py-5">
          <div style="font-size: 48px; margin-bottom: 12px;">📦</div>
          <h4>Hiện chưa có sản phẩm trong danh mục này</h4>
          <p class="text-muted">Chúng tôi đang cập nhật sản phẩm công nghệ mới nhất vào hệ thống.</p>
          <a href="{{ continue }}" class="btn btn-primary" style="background: var(--primary); border: none; padding: 10px 24px; border-radius: 8px; font-weight: 700;">Quay lại mua sắm</a>
        </div>
      {% endif %}

      {{ content_bottom }}
    </div>

    {{ column_right }}
  </div>
</div>
{{ footer }}
