<div class="product-thumb">
  <div class="image">
    <a href="{{ href }}">
      <img src="{{ thumb }}" alt="{{ name }}" title="{{ name }}" class="img-fluid"/>
    </a>
  </div>
  <div class="content" style="display: flex; flex-direction: column; flex-grow: 1;">
    <div class="description">
      <h4><a href="{{ href }}">{{ name }}</a></h4>
      {% if price %}
        <div class="price">
          {% if not special %}
            <span class="price-new">{{ price }}</span>
          {% else %}
            <span class="price-new">{{ special }}</span> <span class="price-old">{{ price }}</span>
          {% endif %}
          {% if tax %}
            <span class="price-tax" style="display:none;">{{ text_tax }} {{ tax }}</span>
          {% endif %}
        </div>
      {% endif %}
    </div>
    <form method="post" data-oc-toggle="ajax" data-oc-load="{{ cart }}" data-oc-target="#cart" style="margin-top: auto;">
      <div class="button">
        <button type="submit" formaction="{{ cart_add }}" class="btn-cart" data-bs-toggle="tooltip" title="{{ button_cart }}">
          <i class="fa-solid fa-cart-shopping"></i> Chọn mua
        </button>
        <button type="submit" formaction="{{ wishlist_add }}" class="btn-action" data-bs-toggle="tooltip" title="{{ button_wishlist }}">
          <i class="fa-regular fa-heart"></i>
        </button>
        <button type="submit" formaction="{{ compare_add }}" class="btn-action" data-bs-toggle="tooltip" title="{{ button_compare }}">
          <i class="fa-solid fa-arrow-right-arrow-left"></i>
        </button>
      </div>
      <input type="hidden" name="product_id" value="{{ product_id }}"/>
      <input type="hidden" name="quantity" value="{{ minimum }}"/>
    </form>
  </div>
</div>
