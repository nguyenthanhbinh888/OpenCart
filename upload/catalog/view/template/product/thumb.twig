<div class="product-thumb tech-thumb-card">
  <!-- Top Badges & Wishlist -->
  <div class="thumb-top-bar">
    <div class="thumb-badges">
      <span class="badge-tag-red">GIẢM 12%</span>
      <span class="badge-tag-installment">TRẢ GÓP 0%</span>
    </div>
    <form method="post" data-oc-toggle="ajax" data-oc-load="{{ cart }}" data-oc-target="#cart" class="thumb-wishlist-form">
      <button type="submit" formaction="{{ wishlist_add }}" class="btn-wishlist-icon" data-bs-toggle="tooltip" title="Thêm vào yêu thích">
        <i class="fa-regular fa-heart"></i>
      </button>
      <input type="hidden" name="product_id" value="{{ product_id }}"/>
      <input type="hidden" name="quantity" value="{{ minimum }}"/>
    </form>
  </div>

  <!-- Image -->
  <div class="thumb-image-wrap">
    <a href="{{ href }}">
      <img src="{{ thumb }}" alt="{{ name }}" title="{{ name }}" class="img-fluid"/>
    </a>
  </div>

  <!-- Content Body -->
  <div class="thumb-content-body">
    <!-- Title -->
    <h4 class="thumb-title">
      <a href="{{ href }}" title="{{ name }}">{{ name }}</a>
    </h4>

    <!-- Tech spec tags -->
    <div class="thumb-spec-chips">
      <span class="chip">Chính hãng VNA</span>
      <span class="chip">Bảo hành 12T</span>
    </div>

    <!-- Rating -->
    <div class="thumb-rating">
      <span class="stars">★★★★★</span>
      <span class="score">5.0</span>
      <span class="sold">(Đã bán 120+)</span>
    </div>

    <!-- Price -->
    {% if price %}
      <div class="thumb-price-row">
        {% if not special %}
          <span class="price-current">{{ price }}</span>
        {% else %}
          <span class="price-current">{{ special }}</span>
          <span class="price-old">{{ price }}</span>
        {% endif %}
      </div>
    {% endif %}

    <!-- Promo gift tag -->
    <div class="thumb-gift-pill">
      🎁 Trợ giá thu cũ đổi mới đến 2.000.000đ
    </div>

    <!-- Actions (Add to Cart) -->
    <div class="thumb-actions">
      <form method="post" data-oc-toggle="ajax" data-oc-load="{{ cart }}" data-oc-target="#cart" style="width: 100%;">
        <button type="submit" formaction="{{ cart_add }}" class="btn-add-cart">
          <i class="fa-solid fa-cart-shopping"></i> Chọn mua ngay
        </button>
        <input type="hidden" name="product_id" value="{{ product_id }}"/>
        <input type="hidden" name="quantity" value="{{ minimum }}"/>
      </form>
    </div>
  </div>
</div>
