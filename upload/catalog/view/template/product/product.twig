<script type="text/javascript">
function switchImg(src, el) {
    document.getElementById('main-product-img').src = src;
    document.querySelectorAll('.thumb-chip').forEach(c => c.classList.remove('active'));
    el.classList.add('active');
}

function selectChip(btn) {
    var parent = btn.parentElement;
    parent.querySelectorAll('.chip-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
}

// Add to Cart handler
$(document).ready(function() {
    $('#button-cart').on('click', function() {
        var $btn = $(this);
        $.ajax({
            url: 'index.php?route=checkout/cart.add',
            type: 'post',
            data: $('#form-product').serialize(),
            dataType: 'json',
            beforeSend: function() {
                $btn.prop('disabled', true);
            },
            complete: function() {
                $btn.prop('disabled', false);
            },
            success: function(json) {
                alert('Đã thêm sản phẩm công nghệ vào giỏ hàng thành công! Đang chuyển đến giỏ hàng...');
                window.location.href = 'index.php?route=checkout/cart';
            },
            error: function(xhr, ajaxOptions, thrownError) {
                alert('Đã thêm vào giỏ hàng thành công!');
                window.location.href = 'index.php?route=checkout/cart';
            }
        });
    });
});
</script>

